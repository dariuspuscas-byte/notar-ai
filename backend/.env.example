# Loaded at runtime by backend/core/src/config.ts for both the api and mcp
# processes. Copy to backend/.env and adjust for your office's hardware.

# Base URL of the local Ollama server (spec §4.2). Never a public/hosted endpoint.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model tag used for document classification (spec §4.2). Must be pulled
# first: `ollama pull llama3.2-vision:11b`.
OLLAMA_MODEL=llama3.2-vision:11b

# How long Ollama keeps the model resident in memory between requests (spec §4.3/§4.6).
OLLAMA_KEEP_ALIVE=30m

# Per-request timeout (ms) for the Ollama classification call. On timeout/unreachable,
# the document is left `pending_classification` — never guessed (spec §4.4).
OLLAMA_TIMEOUT_MS=60000

# Confidence policy threshold (spec §4.4), 0..1. Ship conservative/high per the
# spec's rollout note until this office's real-document accuracy is measured.
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85

# HTTP port for the REST API (backend/api).
PORT=3000

# Root directory for uploaded files (spec §5). Relative paths are resolved
# against backend/data/documents at runtime; override with an absolute path if
# you want storage elsewhere (e.g. a mounted volume).
DOCUMENTS_ROOT=./data/documents

# DB connection URL, read by both the app (async engine) and by Alembic
# migrations (which swap in a sync driver — see backend/core/alembic/env.py).
# Optional: if unset, defaults to SQLite at backend/data/notar-ai.db (spec
# §5/§6's documented default), which is fine for a from-scratch checkout.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/notar-ai.db
#
# Or point at Postgres instead (async driver = asyncpg; Alembic uses psycopg2
# under the hood automatically). This repo's local dev instance runs against
# a Docker container (see root docker-compose.yml / backend/README.md):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:PORT/dbname
