# Read by docker-compose.yml. Copy this file to .env and adjust if needed.
# Every value has a default in docker-compose.yml, so .env is optional.

# Postgres container credentials (the backend container's DATABASE_URL is
# derived from these).
POSTGRES_DB=notary_db
POSTGRES_USER=admin
# Placeholder only — do not use this in anything beyond a local container.
POSTGRES_PASSWORD=admin

# Host ports. Change any of them if something else on your machine already
# listens there.
POSTGRES_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=8080

# Ollama runs on the host, not in Docker.
# Ollama runs as the `ollama` compose service. To use an Ollama installed on
# the host instead (e.g. native on macOS, which can use the Apple GPU), set:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2-vision:11b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=240000
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85
