# Base URL for the notar-ai REST API (spec ARCHITECTURE.md §3). Base path per
# the contract is "/api/v1". While the real backend isn't up yet, leave this as
# a relative path and keep VITE_ENABLE_MOCKS=true — the mock service worker
# (msw) intercepts requests to this path regardless of host.
#
# Once the real backend is running, point this at it, e.g.:
#   VITE_API_BASE_URL=http://localhost:3001/api/v1
# and set VITE_ENABLE_MOCKS=false.
VITE_API_BASE_URL=/api/v1

# true  -> requests are served by the in-browser mock server (src/mocks), no
#          backend required. Good for development/demo against the frozen
#          contract before the backend exists.
# false -> requests go to VITE_API_BASE_URL for real.
VITE_ENABLE_MOCKS=true
